# PostgreSQL Database Configuration (entirely OPTIONAL for the dashboard).
# The app falls back to processed CSV data when these are absent.
# Set DB_ENABLED=false to force CSV fallback even when a password is present.
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobpulse_db
DB_USER=postgres
DB_PASSWORD=your_password

# Streamlit Community Cloud: add the same keys under [secrets]
# (.streamlit/secrets.toml locally, or the app's Secrets section in the cloud):
#   DB_HOST = "..."
#   DB_PORT = "5432"
#   DB_NAME = "jobpulse_db"
#   DB_USER = "postgres"
#   DB_PASSWORD = "..."
# Never commit real credentials - .streamlit/secrets.toml is gitignored.

# Data Paths
DATA_PATH=data/raw/jobs.csv
DATA_OUTPUT_DIR=data/processed

# Application Settings
ENV=development
DEBUG=True